# Plantilla de variables de entorno — copia este archivo a `.env` y rellena.
# El `.env` real NO se sube al repositorio (está en .gitignore).

# ─── Postgres (compartido por todos los microservicios) ───
POSTGRES_USER=mascotacare
POSTGRES_PASSWORD=cambiar_en_produccion

# ─── JWT ───
# Genera una con:  openssl rand -base64 48
JWT_SECRET=reemplaza-por-una-clave-segura-de-al-menos-32-chars

# ─── Service discovery interno ───
EUREKA_URL=http://eureka-server:8080/eureka
SPRING_PROFILES_ACTIVE=docker

# ─── (Opcional) credenciales de servicios externos ───
# Déjalas vacías para correr en modo MOCK (logs).
FCM_KEY=
SENDGRID_API_KEY=
TWILIO_SID=
AI_API_KEY=
